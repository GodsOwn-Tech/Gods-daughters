JWT_SECRET=change-this-to-a-long-random-string
PORT=4000

# Optional — only needed for "forgot password" emails to actually send.
# Without these, reset codes print to the terminal instead (fine for
# local development). Most email providers require an "app password"
# here rather than your normal login password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
